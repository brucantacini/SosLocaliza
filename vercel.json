{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/alerts",
      "destination": "https://centralsoslocaliza.vercel.app/api/v1/alerts"
    },
    {
      "source": "/api/v1/health",
      "destination": "https://centralsoslocaliza.vercel.app/api/v1/health"
    }
  ]
}
