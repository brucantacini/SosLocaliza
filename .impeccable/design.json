    {
      "name": "Communicate alert",
      "kind": "button",
      "refersTo": "button-alert",
      "description": "Red two-line entry action for the simulated occurrence flow.",
      "html": "<button class=\"ds-alert\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10.3 3.9 2.5 17.4A2 2 0 0 0 4.2 20h15.6a2 2 0 0 0 1.7-2.6L13.7 3.9a2 2 0 0 0-3.4 0Z\"/><path d=\"M12 9v4m0 4h.01\"/></svg><span><strong>Comunicar estado de alerta</strong><small>Registrar ocorrência simulada</small></span><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-alert{display:grid;grid-template-columns:28px minmax(0,1fr) 20px;align-items:center;gap:12px;min-height:72px;padding:14px 24px;border:0;border-radius:100px;background:var(--alert-action);color:#fff;font-family:var(--font-body);text-align:left;cursor:pointer;transition:background .16s ease,border-color .16s ease}.ds-alert>span{display:grid;gap:4px;min-width:0}.ds-alert strong{font-size:16px;line-height:1.4;font-weight:600}.ds-alert small{font-size:14px;font-weight:400;line-height:1.4}.ds-alert:hover{background:#bf3440}.ds-alert:focus-visible{outline:3px solid var(--focus);outline-offset:4px}@media(max-width:650px){.ds-alert{min-height:76px;padding:14px 20px;gap:10px}.ds-alert strong{font-size:15px}}@media(prefers-reduced-motion:reduce){.ds-alert{transition:none}}"
