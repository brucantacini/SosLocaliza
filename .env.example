# Copie para ".env.local" (ou ".env") na raiz do projeto.
# Esses arquivos já estão no .gitignore — não vão para o Git.

# JDK local (Windows; ajuste o caminho se necessário)
JAVA_HOME=C:\Program Files\Java\jdk-21.0.10

# Perfil padrão da aplicação é oracle-fiap (dados no Oracle).
# Para subir com H2 em ficheiro (sem Oracle): SPRING_PROFILES_ACTIVE=dev
SPRING_PROFILES_ACTIVE=oracle-fiap
SERVER_PORT=8082

ORACLE_HOST=oracle.fiap.com.br
ORACLE_PORT=1521
ORACLE_SID=ORCL
ORACLE_USERNAME=seu_usuario
ORACLE_PASSWORD=sua_senha
